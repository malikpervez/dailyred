# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Discord Developer Portal > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The bot (live card and morning recap in #general), see docs/discord-activity.md step 6.
# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# ...> General Information > Public Key (for the Battle RED / Leaderboard buttons)
DISCORD_PUBLIC_KEY=
# This site's public HTTPS address, for the picture in the bot's messages
PUBLIC_URL=
DAILYRED_CHANNEL=general
RECAP_TIME=06:00
RECAP_TIMEZONE=America/New_York

# Only with the Cloudflare Tunnel option (docker compose --profile tunnel up -d):
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token
CLOUDFLARE_TUNNEL_TOKEN=

# Port on the Pi for a reverse proxy you already run (Nginx Proxy Manager, SWAG, Caddy...)
DAILYRED_PORT=8380
